# Este demo NO se conecta a ningún proyecto real de Firebase.
# El backend se niega a arrancar si FIRESTORE_EMULATOR_HOST no está seteado.

GCLOUD_PROJECT=demo-vendelo
FIRESTORE_EMULATOR_HOST=emulator:8085

# Dominio raíz para resolver subdominios. En local alcanza con *.localhost.
ROOT_DOMAIN=vendelo.uy

PORT=8080
BACKEND_URL=http://backend:8080
